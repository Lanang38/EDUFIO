# Salin file ini ke .env.local lalu isi dengan connection string MongoDB kamu.
# Tidak pernah commit .env.local — sudah masuk .gitignore.

# MongoDB lokal (butuh mongod jalan di mesinmu):
MONGODB_URI=mongodb://127.0.0.1:27017

# Atau MongoDB Atlas (gratis, tidak perlu install apa pun):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

MONGODB_DB=edufio
